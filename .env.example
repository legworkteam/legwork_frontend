# 배포(Vercel/Netlify) 환경변수. 이 파일을 복사해 .env.production 또는 대시보드에 등록하세요.

# 백엔드 API 주소 (명세 1.1)
VITE_API_URL=https://api.example.com/api/v1

# 소셜 로그인 — 각 콘솔에 Redirect URI 로 `<배포주소>/oauth/callback` 을 등록해야 합니다.
VITE_KAKAO_CLIENT_ID=카카오_REST_API_키
VITE_GOOGLE_CLIENT_ID=구글_OAuth_클라이언트_ID

# 더미 모드로 배포하려면(데모용) 아래 주석을 해제. 기본값은 실제 API 호출입니다.
# VITE_USE_MOCK=true
